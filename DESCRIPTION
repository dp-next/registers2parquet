Package: fastreg
Title: Work Faster on Danish Registers with Parquet
Version: 0.8.13
Authors@R: c(
    person("Signe Kirk", "Brødbæk", , "signekb@clin.au.dk", role = c("aut", "cre"),
           comment = c(ORCID = "0009-0000-2208-7088", affiliation="Steno Diabetes Center Aarhus")),
    person("Luke", "Johnston", , "lwjohnst@gmail.com", role = c("aut"),
           comment = c(ORCID = "0000-0003-4169-2616", affiliation="Steno Diabetes Center Aarhus"))
